# Copia este archivo a .env y ajusta los valores si es necesario
PORT=4000

# Opción Supabase (recomendada). Si defines DATABASE_URL se ignoran las DB_*.
# Project Settings -> Database -> Connection string -> URI (Session pooler).
# DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Opción PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD
DB_NAME=mercado_libre
# Clave usada para firmar los tokens de sesión. Cámbiala en producción.
AUTH_SECRET=mercado-libre-secreto-de-desarrollo
